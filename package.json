{
  "name": "nutrisnap-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev -w @nutrisnap/web",
    "web:build": "npm run build -w @nutrisnap/web",
    "web:start": "npm run start -w @nutrisnap/web",
    "web:lint": "npm run lint -w @nutrisnap/web",
    "mobile:start": "npm run start -w @nutrisnap/mobile",
    "mobile:android": "npm run android -w @nutrisnap/mobile",
    "mobile:ios": "npm run ios -w @nutrisnap/mobile",
    "mobile:web": "npm run web -w @nutrisnap/mobile"
  }
}
